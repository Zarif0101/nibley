{
  "manifest_version": 3,
  "name": "Nibley for YouTube",
  "version": "0.2.0",
  "description": "Sends the YouTube video's time and transcript to Nibley on this computer (127.0.0.1 only).",
  "host_permissions": ["http://127.0.0.1:47711/*"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["page.js"], "world": "MAIN", "run_at": "document_idle" },
    { "matches": ["https://www.youtube.com/*"], "js": ["bridge.js"], "run_at": "document_idle" }
  ]
}
